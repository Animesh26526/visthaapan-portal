# VISTHAAPAN Frontend Environment Configuration
# Backend API base URL (Default: local development backend)
# In production (e.g. Vercel), set to your deployed backend URL: https://<your-render-app>.onrender.com/api/v1
VITE_API_URL=http://localhost:5000/api/v1
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Set to true for purely offline demonstration mode without backend
VITE_USE_MOCK_API=false
