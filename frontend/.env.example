# VISTHAAPAN Portal Client Environment Configuration
# When VITE_USE_MOCK_API is 'true', frontend uses deterministic mock services from src/mock/data.ts
# When VITE_USE_MOCK_API is 'false', frontend connects to the backend API at VITE_API_BASE_URL
VITE_USE_MOCK_API=true
VITE_API_BASE_URL=http://localhost:5000/api/v1
