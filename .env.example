# ==============================================================================
# VISTHAAPAN — Environment Configuration Template
# ==============================================================================
# This repository is organized as a monorepo with /frontend and /backend.
# Copy this file or configure environment variables in your respective hosting environments:
# - Backend (Render Docker / Linux): backend/.env
# - Frontend (Vercel / Vite): frontend/.env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND SERVICE ENVIRONMENT VARIABLES (backend/.env or Render Service Vars)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=5000
API_PREFIX=/api/v1
LOG_LEVEL=info

# Allowed frontend origin(s) for CORS. Can be a comma-separated list in production:
# Example: https://visthaapan.vercel.app,http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL + PostGIS Connection String
# For Local PostGIS: postgresql://visthaapan:visthaapan_dev@localhost:5432/visthaapan
# For Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Note: SSL is automatically negotiated with rejectUnauthorized: false for remote hosts.
DATABASE_URL=postgresql://visthaapan:visthaapan_dev@localhost:5432/visthaapan

# Optional discrete DB parameters (if DATABASE_URL is not provided)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=visthaapan
DB_USER=visthaapan
DB_PASSWORD=visthaapan_dev

# Python binary path (optional, auto-detected: 'python3' on Linux/Docker, 'python' on Windows)
# PYTHON_BIN=python3

# Groq Cloud LLM Configuration (Officer Copilot & Multilingual Operational Briefing)
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ------------------------------------------------------------------------------
# 2. FRONTEND APPLICATION ENVIRONMENT VARIABLES (frontend/.env or Vercel Project Vars)
# ------------------------------------------------------------------------------
# Points to the Backend API base URL.
# In production (e.g. Vercel), set to your deployed backend URL ending in /api/v1
# Example: https://visthaapan-api.onrender.com/api/v1
VITE_API_URL=http://localhost:5000/api/v1
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Set to true only for offline demonstration mode without live backend connectivity
VITE_USE_MOCK_API=false
