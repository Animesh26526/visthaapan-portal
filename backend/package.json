{
  "name": "visthaapan-backend",
  "version": "1.0.0",
  "description": "VISTHAAPAN Portal - Node.js + Express REST API Gateway",
  "private": true,
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx test/foundation.test.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:status": "tsx src/db/status.ts",
    "db:test": "tsx test/db.test.ts",
    "ingest:disasters": "tsx src/pipeline/runIngest.ts",
    "seed:benchmark": "tsx src/pipeline/runBenchmark.ts",
    "pipeline:test": "tsx test/pipeline.test.ts",
    "ingest:enrichment": "tsx src/pipeline/runEnrichment.ts",
    "enrichment:test": "tsx test/enrichment.test.ts",
    "ai:train": "python -m ai.risk.train",
    "test:ai": "tsx test/ai.test.ts",
    "test:validation": "tsx test/ai_validation.test.ts",
    "gis:setup": "tsx src/pipeline/runGisSetup.ts",
    "test:gis": "tsx test/gis.test.ts",
    "test:all": "tsx test/foundation.test.ts && tsx test/db.test.ts && tsx test/pipeline.test.ts && tsx test/enrichment.test.ts && tsx test/ai.test.ts && tsx test/ai_validation.test.ts && tsx test/gis.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
