# Application Environment
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:5173

# Logging (trace, debug, info, warn, error, fatal)
LOG_LEVEL=info

# PostgreSQL + PostGIS Database Connection
# Local: postgresql://visthaapan:visthaapan_dev@localhost:5432/visthaapan
# Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://visthaapan:visthaapan_dev@localhost:5432/visthaapan
DB_HOST=localhost
DB_PORT=5432
DB_NAME=visthaapan
DB_USER=visthaapan
DB_PASSWORD=visthaapan_dev

# Optional: Path to python interpreter (defaults to 'python3' on Linux/Docker, 'python' on Windows)
# PYTHON_BIN=python3

# Groq Cloud LLM Integration (openai/gpt-oss-20b)
# Obtain an API key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
